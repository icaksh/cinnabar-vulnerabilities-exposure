# PostgreSQL
POSTGRES_USER=cve
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cve

# API
CVE_HTTP_ADDR=:8080
CVE_API_PORT=8080

# Optional API authentication. Comma-separated bearer tokens. Empty = open.
CVE_API_KEYS=

# Optional NVD API key (higher rate limits)
NVD_API_KEY=

# Sync scheduling
NVD_SYNC_INTERVAL=30m
KEV_SYNC_INTERVAL=2h

# Request limits
CVE_MAX_BATCH_ITEMS=1000
CVE_MAX_PAGE_SIZE=100

# Logging: debug | info | warn | error
CVE_LOG_LEVEL=info